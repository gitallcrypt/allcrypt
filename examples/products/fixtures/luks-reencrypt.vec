# LUKS2 volumes stopped in the middle of `cryptsetup reencrypt`, written by
# scripts/make_luks_reencrypt_fixtures.py; do not edit. Each was repaired,
# finished and decrypted by cryptsetup to the plaintext whose SHA-256 is
# data_sha256. passphrase `-`: the keyslot material is not kept; open with
# old_key and new_key. cryptsetup 2.8.8.

[cryptsetup]
name = interrupted-checksum
image = luks/reencrypt/interrupted-checksum.sparse
passphrase = reencrypt passphrase
old_key = 88df7b88103e8f337c50a46026feae10
new_key = 1dc90a377ccbab07aad71af5648bd123924a778dd9f4d0759879f84b542c33d9
resilience = checksum
stopped = SIGTERM at data write 2
state = no hotzone
data_length = 65536
data_sha256 = 135d2fbb4ac1895597c9c5f225328954c9582906751106bf0c9bf2368915384e

name = checksum-before-write
image = luks/reencrypt/checksum-before-write.sparse
