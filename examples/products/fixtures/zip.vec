# Archives the witnesses wrote, kept by scripts/check_zip.py --record,
# with the SHA-256 of every file in each. The password is
# 636f727265637420686f727365206261747465727920737461706c65 (hex of its UTF-8).

[archive]
name = infozip-0.zip
made_by = Info-ZIP zip -0 ZipCrypto
name = infozip-0-pipe.zip
made_by = Info-ZIP zip -0 ZipCrypto to a pipe
name = infozip-6.zip
made_by = Info-ZIP zip -6 ZipCrypto
name = infozip-6-pipe.zip
made_by = Info-ZIP zip -6 ZipCrypto to a pipe
name = infozip-zip64.zip
made_by = Info-ZIP zip -fz (ZIP64) ZipCrypto
name = bsdtar-zipcrypt-store.zip
