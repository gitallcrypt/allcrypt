made_by = 7-Zip AES128 Copy
name = 7zz-AES128-Deflate.zip
made_by = 7-Zip AES128 Deflate
name = 7zz-AES128-BZip2.zip
made_by = 7-Zip AES128 BZip2
name = 7zz-AES192-Copy.zip
made_by = 7-Zip AES192 Copy
name = 7zz-AES192-Deflate.zip
made_by = 7-Zip AES192 Deflate
name = 7zz-AES192-BZip2.zip
