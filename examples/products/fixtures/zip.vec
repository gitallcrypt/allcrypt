name = 7zz-AES256-Copy.zip
made_by = 7-Zip AES256 Copy
name = 7zz-AES256-Deflate.zip
made_by = 7-Zip AES256 Deflate
name = 7zz-AES256-BZip2.zip
made_by = 7-Zip AES256 BZip2

