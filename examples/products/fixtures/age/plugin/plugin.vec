# The age example and age 1.3.2's plugins, written by
# scripts/make_age_plugin_fixtures.py; do not edit. Each record is one
# conversation: SESSION.to is what the example wrote to the plugin,
# SESSION.from what the plugin answered. ours-*: the example encrypting
# plain with seed_number, the file opened as opened_by says; age-*: age's
# file, the example decrypting through the plugin.
# passphrase (batchpass): plugin passphrase

[keys]
name = pq
recipient = 
identity = AGE-SECRET-KEY-PQ-1ZWL2UFQYF9LS5DCNVHWMNER7U7KG6U6FM9P6YSH8FJXH57F4SC4QAUUJTK
plugin_identity = AGE-PLUGIN-PQ-1ZWL2UFQYF9LS5DCNVHWMNER7U7KG6U6FM9P6YSH8FJXH57F4SC4QXFXWD4

[sessions]
name = ours-tag.age
session = ours-tag.age.0
plugin = tag
protocol = recipient-v1
args = -r age1tag1qdsl8x5gfqlmxhugvhy969985lls5v5w8735s2xghsq56vm2hmh924zmtym --plugin-recipients
seed_number = 400
opened_by = age-tag-witness

name = ours-tagpq.age
session = ours-tagpq.age.0
plugin = tagpq
protocol = recipient-v1
args = -r  --plugin-recipients
seed_number = 401
opened_by = age-tag-witness

name = ours-pq.age
session = ours-pq.age.0
plugin = pq
protocol = recipient-v1
args = -r PQ_RECIPIENT --plugin-recipients
seed_number = 403
opened_by = age 1.3.2, the native identity

name = ours-batchpass.age
session = ours-batchpass.age.0
plugin = batchpass
protocol = recipient-v1
args = -j batchpass
seed_number = 404
opened_by = age 1.3.2 -j batchpass

name = age-pq.age
session = age-pq.age.0
plugin = pq
protocol = identity-v1
args = -i PQ_PLUGIN_IDENTITY
made_by = age 1.3.2

name = age-batchpass.age
session = age-batchpass.age.0
plugin = batchpass
protocol = identity-v1
args = -j batchpass
made_by = age 1.3.2 -j batchpass
