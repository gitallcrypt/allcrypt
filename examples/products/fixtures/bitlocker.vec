# BitLocker volumes Windows made, from cryptsetup's tests/bitlk-images,
# for examples/products/bitlocker's tests. Written by
# scripts/check_bitlocker.py --record. Each image is
# fixtures/bitlocker/NAME.sparse (its non-zero 512-byte blocks);
# password, recovery and sha256 are images.conf's, volume_key is what
# `cryptsetup bitlkDump --dump-volume-key` printed, opened_by the first
# secret that opened it, and each sample START:LENGTH:SHA256 a stretch
# of the decrypted volume whose whole SHA-256 matched sha256. Do not
# edit.
#
# cryptsetup 2.8.8 flags: UDEV BLKID KEYRING KERNEL_CAPI HW_OPAL

[windows]

