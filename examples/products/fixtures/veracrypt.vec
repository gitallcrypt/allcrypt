name = tc-whirlpool
arguments = --truecrypt --hash whirlpool
volume = veracrypt/tc-whirlpool.sparse
password = aaaaaaaaaaaa
pim = 0
hash = whirlpool
master_key = df6e26279f9126c70b5141c5193ee96a662974d0430496b855792924414a9f39e2c2701569300e8b1aadf1638ddeb78cc6d9e0af9cb6fe586cdcd042ec1031e3
