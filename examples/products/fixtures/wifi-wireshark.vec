# Wi-Fi captures from Wireshark's decryption tests, for
# examples/products/wifi's tests. Written by
# scripts/check_wifi_wireshark.py --record; do not edit. frames are the
# frame numbers (from 1) both decrypted; plaintext_sha256 is the SHA-256 of
# their plaintexts in that order, which equalled tshark's.
#
# TShark (Wireshark) 4.6.9 (v4.6.9-0-g2d548b197c75).

[captures]
name = wpa-test-decode-mgmt.pcap
capture = wifi/wireshark/wpa-test-decode-mgmt.pcap
shows = management frame protection: action and deauthentication frames
essid = Valium_dongle
password = 12345678
pmk = -
frames = 9,10,11
plaintext_sha256 = 0c5a565045a7f4e49bb84c2976442e148d1ce57c73c276f15bed478358bf9244

