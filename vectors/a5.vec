[A5/2 setup]
# The section's first vector at three points of the setup: after the
# 64 key bits, after the 22 count bits (the four forced bits included),
# and after 100 irregular clocks. That last state is the one the first
# output bit is computed from: A5/2's output is taken before each clock,
# where A5/1's is taken after it. Registers as integers; bit 0 is the bit
# most recently shifted in.
key = 00fcffffffffffff
count = 000021
after_key.R1 = 4f148
after_key.R2 = 3ff3ff
after_key.R3 = 414ccd
after_key.R4 = 01f38
after_count.R1 = 6ff45
after_count.R2 = 211400
after_count.R3 = 750232
after_count.R4 = 006ef
after_mixing.R1 = 33195
after_mixing.R2 = 3cc07c
after_mixing.R3 = 151b22
after_mixing.R4 = 0ce3e
