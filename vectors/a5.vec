# A5/1 and A5/2, the GSM voice-privacy stream ciphers. Do not edit.
#
# key    - 8 bytes. Bit i of the key is (key[i / 8] >> (i % 8)) & 1, and bit 0
#          is loaded first: least significant bit of the first byte first.
#          This is the convention of Briceno, Goldberg and Wagner's 1999
#          pedagogical implementations. libosmocore numbers the key bytes
#          the other way round (key[7 - i / 8]), so its test key
#          0123456789abcdef is efcdab8967452301 here.
# count  - the 22-bit COUNT the cipher takes, loaded least significant bit
#          first. fn is the GSM TDMA frame number it comes from:
#          count = (fn / 1326) << 11 | (fn % 51) << 5 | (fn % 26).
# downlink, uplink - the 114-bit blocks, A->B then B->A, generated one after
#          the other. Bit j of a block is bit 7 - j % 8 of byte j / 8:
#          most significant bit first, and the last byte's low six bits are
#          zero padding.
#
# Every row was produced by each implementation available and kept only
# where all of them agree:
#   A5/1: the original A5/1 pedagogical implementation (A5.1.c, whose own
#         self-test passes), the combined A5/1+A5/2 code as carried by
#         airprobe and gr-gsm (a5-1-2.h), and libosmocore's src/gsm/a5.c;
#   A5/2: a5-1-2.h and libosmocore's src/gsm/a5.c.
# The first row of each section is the vector published with the 1999 code;
# the second is libosmocore's tests/a5/a5_test.c vector in this key order.

[A5/1]
key = 1223456789abcdef
fn = 774
count = 000134
downlink = 534eaa582fe8151ab6e1855a728c00
uplink = 24fd35a35d5fb6526d32f906df1ac0

key = efcdab8967452301
fn = 123456
count = 02ec88
downlink = cba25576175d3b1c7b2f29a8c1b600
uplink = d9035e0f2aec139a05d4a87bb16480

