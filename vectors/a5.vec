[A5/1 setup]
# The section's first vector at three points of the setup: after the
# 64 key bits, after the 22 count bits, and after the 100 mixing clocks,
# before any output. Registers as integers; bit 0 is the bit most
# recently shifted in.
key = 1223456789abcdef
count = 000134
after_key.R1 = 4030d
after_key.R2 = 1fa05c
after_key.R3 = 3668e1
after_count.R1 = 064a2
after_count.R2 = 2bc0e5
after_count.R3 = 72df8d
after_mixing.R1 = 1da4b
after_mixing.R2 = 2cb2f9
after_mixing.R3 = 08be5f

